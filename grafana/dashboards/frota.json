          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM alertas WHERE tipo_infracao IN ('EXCESSO_VELOCIDADE','FORA_GEOFENCE') AND \"timestamp\" > now() - interval '5 minutes'"
