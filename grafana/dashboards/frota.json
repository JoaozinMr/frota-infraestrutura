    {
      "id": 5,
      "type": "stat",
      "title": "Eventos duplicados",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "frota-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "frota-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FROM (SELECT 1 FROM telemetria WHERE $__timeFilter(ts) GROUP BY id_evento, ts HAVING count(*) > 1) d"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Deve ser sempre 0: reentregas (retry do simulador, rebalanceamento do consumer group) são descartadas pelo índice único (id_evento, ts)."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Alertas de geofence/velocidade (5 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "frota-postgres"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
