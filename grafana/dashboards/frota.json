  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Eventos/s (último minuto)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "frota-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "frota-postgres"
          },
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) / 60.0 AS eventos_s FROM telemetria WHERE ts > now() - interval '65 seconds' AND ts <= now() - interval '5 seconds'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "description": "Leituras persistidas pelo Worker no último minuto (o batch é gravado a cada 2s; os últimos 5s são ignorados)."
    },
